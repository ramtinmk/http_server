[Unit]
Description=SimpleHTTP static file server
After=network.target

[Service]
Type=notify
User=http-server
Group=http-server
ExecStart=/usr/local/bin/http_server --config /etc/http-server/http_server.conf
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/http-server /var/lib/http-server /run/http-server
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service @network-io @file-system @signal @io-event @process
SystemCallErrorNumber=EPERM
LimitNOFILE=4096
LimitCORE=0
RuntimeDirectory=http-server
StateDirectory=http-server

[Install]
WantedBy=multi-user.target
